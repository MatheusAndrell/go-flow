# Copy to .env (never commit real secrets). Every variable is optional except the database URL.
GOFLOW_DATABASE_URL=postgres://goflow:goflow@localhost:5432/goflow?sslmode=disable
GOFLOW_DATABASE_MAX_CONNS=20
GOFLOW_AUTO_MIGRATE=false

GOFLOW_HTTP_ADDR=:8080
GOFLOW_SHUTDOWN_TIMEOUT=30s
GOFLOW_RATE_LIMIT_RPS=50
GOFLOW_RATE_LIMIT_BURST=100
GOFLOW_AUTH_CACHE_TTL=30s
GOFLOW_IDEMPOTENCY_TTL=24h
GOFLOW_MAX_REQUEST_BYTES=1048576

GOFLOW_WORKER_ID=
GOFLOW_WORKER_CONCURRENCY=10
GOFLOW_WORKER_POLL_INTERVAL=500ms
GOFLOW_WORKER_LEASE_DURATION=30s
GOFLOW_WORKER_HEARTBEAT_INTERVAL=10s
GOFLOW_METRICS_ADDR=:9090
GOFLOW_EXAMPLE_HANDLERS=true

GOFLOW_SCHEDULER_INTERVAL=1s
GOFLOW_SCHEDULER_BATCH_SIZE=100

GOFLOW_LOG_LEVEL=info
GOFLOW_LOG_FORMAT=json
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
GOFLOW_TRACE_SAMPLE_RATIO=1
